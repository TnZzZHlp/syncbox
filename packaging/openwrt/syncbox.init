#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

PROG=/usr/bin/syncbox
DATA_DIR=/etc/syncbox

start_service() {
	[ -x "$PROG" ] || return 1
	mkdir -p "$DATA_DIR"
	chmod 700 "$DATA_DIR"

	procd_open_instance
	procd_set_param command "$PROG" run
	procd_set_param env "SYNCBOX_DATA_DIR=$DATA_DIR"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
